# GEMINI_API_KEY: Required for Gemini AI API calls.
# Read ONLY by the Express server in server/index.ts. It is never bundled into
# the client, so it must not be referenced from anything under src/ or exposed
# through vite.config.ts `define` or a VITE_-prefixed name.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: Port the API server listens on. Defaults to 8080.
PORT="8080"
